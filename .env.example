APP_NAME="Media Archive Cloud API"
APP_ENVIRONMENT=development
DEBUG=false

SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred: Settings > API Keys > Secret key (never a publishable/anon key).
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_only_key
# Legacy deployments may use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
JWKS_CACHE_LIFESPAN_SECONDS=300
JWKS_REQUEST_TIMEOUT_SECONDS=5

EDGE_HMAC_SECRET=replace-with-a-long-random-shared-secret
EDGE_SIGNATURE_MAX_AGE_SECONDS=300
FACE_MATCH_THRESHOLD=0.6
