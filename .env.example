APP_NAME="MediaNest AI"
APP_ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SUPABASE_URL=https://your-project-ref.supabase.co
# Server only; never put this key in VITE_ variables.
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_only_key
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_LIFESPAN_SECONDS=300
JWKS_REQUEST_TIMEOUT_SECONDS=5

EDGE_HMAC_SECRET=replace-with-a-long-random-shared-secret
EDGE_SIGNATURE_MAX_AGE_SECONDS=300
FACE_MATCH_THRESHOLD=0.6

# Optional: configure after registering your local storage node.
# LOCAL_NODE_ID=your-registered-node-uuid
# LOCAL_NODE_SECRET=use-a-random-secret-of-at-least-32-characters
