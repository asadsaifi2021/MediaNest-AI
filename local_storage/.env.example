LOCAL_NODE_ID=your-registered-node-uuid
LOCAL_NODE_SECRET=use-the-same-random-node-secret-as-the-metadata-backend
MEDIA_ROOT=C:/MediaNestData
METADATA_API_URL=http://127.0.0.1:8000
# Include only the frontend origins you actually use. No wildcard.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Optional local AI models; never set these in frontend/.env.local.
# YOLO_MODEL_PATH=C:/MediaNestModels/yolov8n.pt
# YOLO_LICENSE_ACCEPTED=false
# WHISPER_MODEL_PATH=C:/MediaNestModels/faster-whisper-base
# YUNET_MODEL_PATH=C:/MediaNestModels/face_detection_yunet_2023mar.onnx
# SFACE_MODEL_PATH=C:/MediaNestModels/face_recognition_sface_2021dec.onnx
ENABLE_FACE_RECOGNITION=false
